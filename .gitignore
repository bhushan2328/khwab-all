# =============================================================
# khwab-all root .gitignore
# =============================================================

# Bob workspace — generated logs, build artifacts, temp files
# The .bob/ directory contains only generated/temporary content
# and must never be committed.
.bob/*.log
.bob/tmp/apk_verify/
.bob/tmp/unity-jar/
.bob/xlsx-dumps/

# IDE
.idea/workspace.xml
.idea/shelf/

# OS
.DS_Store
Thumbs.db

# HTML reports generated by Bob tasks (not source)
khwab-aura-complete-phase-architecture-report.html
